# Auth.js session encryption key — required in every mode. Generate with:
#   npx auth secret
AUTH_SECRET=

# Self-host password fallback. Only used when neither GOOGLE_CLIENT_ID nor
# GITHUB_CLIENT_ID (below) is set — set one of those for a hosted deployment
# instead, and leave this blank.
APP_PASSWORD=

# Override the local SQLite file path (defaults to file:./data/flatpare.db).
# Tests set this to a separate file so they don't clobber the dev database.
# LOCAL_DB_URL=

# End-to-end encryption. Unset (or "on") means on; "off" disables the client
# key setup entirely. The value is stamped into the database on first boot and
# the app refuses to start if it later disagrees — changing it means a fresh
# database. See docs/security-notes.md.
# FLATPARE_ENCRYPTION=on

# --- OAuth (hosted tier) ---
# Set BOTH id and secret for a provider, or neither — a lone CLIENT_ID
# registers a broken provider and disables the APP_PASSWORD fallback above,
# locking everyone out. Register callback URLs with each provider before
# deploying (production domain + every Vercel preview URL).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Cloud mode (Vercel deployment) ---

# Turso database (omit for local SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob storage (omit for local filesystem)
BLOB_READ_WRITE_TOKEN=

# Google Gemini for PDF parsing (omit to fall back to manual entry)
GOOGLE_GENERATIVE_AI_API_KEY=

# Google Maps Distance Matrix API (omit to use OpenRouteService or manual entry)
GOOGLE_MAPS_API_KEY=

# --- Local/self-hosted mode (free alternatives) ---

# OpenRouteService for distance calculation (omit if using Google Maps)
# OPENROUTESERVICE_API_KEY=

# --- Limits (all optional; unset means unlimited) ---
#
# Every ceiling below is opt-in. Unset — the default you get from
# `docker compose up` — means no restriction at all, because a self-hoster
# spends their own resources. The hosted deployment sets explicit values.
# Anything that is not a positive integer fails loudly at first use rather
# than being coerced.

# Per-household hourly ceiling on EACH /api/process/* endpoint (geocode,
# distance, check-listing, parse-pdf). These spend the host's Gemini and Maps
# budget on behalf of any signed-in member, so a hosted deployment wants a
# value here. See docs/security-notes.md, "Blind-proxy hardening".
# PROCESS_RATE_LIMIT_PER_HOUR=

# Per-household entitlement caps (E5). Enforced server-side on row counts —
# no decryption needed — and mirrored in the UI. There is no tier dimension:
# these apply to every household.
#
# The hosted deployment sets 10 and 40 — that is what the landing page sells
# for CHF 5. Leaving them unset there would silently hand paying customers
# unlimited use and make the pricing copy untrue.
# MAX_MEMBERS=10
# MAX_APARTMENTS=40

# --- Public site (E7) ---

# Canonical origin, used only to build absolute URLs for metadata (canonical,
# Open Graph, Twitter cards). Set this to the real domain in production once
# DNS points at the deployment. Unset falls back to Vercel's production URL,
# then to http://localhost:3002 for local dev — so this is optional and
# nothing routes off it.
# NEXT_PUBLIC_SITE_URL=https://example.com

# --- Billing (E6) ---

# Stripe, provisioned through the Vercel Marketplace integration
# (`vercel integration add stripe`), which injects the first two.
#
# BILLING IS OFF UNLESS STRIPE_SECRET_KEY IS SET. With it unset — the
# self-hosted default — the apartment credit quota is not enforced at all and
# `apartments_ever_added` is never incremented, so switching billing on later
# does not bill anyone for apartments they added while it was off.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
#
# Local development: leave STRIPE_SECRET_KEY unset. Billing is then off, the
# quota is not enforced, and the app behaves like a self-hosted install. Set
# it only when you are actually working on billing, and use a test key
# (sk_test_...) with Stripe's test cards — 4242 4242 4242 4242, any future
# expiry. `stripe listen --forward-to localhost:3002/api/billing/webhook`
# forwards test events to your machine and prints a signing secret to use
# below.

# Signing secret for POST /api/billing/webhook. NOT injected by the
# integration — create the endpoint in the Stripe dashboard and copy it here.
# The webhook is the only thing that grants credits, so without this nobody
# who pays receives anything.
# STRIPE_WEBHOOK_SECRET=
